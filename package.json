{
  "name": "question-patterns",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:visual": "node scripts/visual-check.mjs",
    "test:visual:session": "node scripts/session-visual-check.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "install:local": "npm run build && node scripts/install-plugin-local.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.27.0",
    "jsdom": "^27.0.0",
    "@types/jsdom": "^27.0.0",
    "learnharness-plugin-api": "file:./.sdk",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
